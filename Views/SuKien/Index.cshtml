@model IEnumerable<EventHub.Models.SuKien>
@{
    ViewData["Title"] = "Danh sách sự kiện";
    var chuDes = ViewBag.ChuDes as List<EventHub.Models.ChuDe> ?? new();
    int? maChuDe = ViewBag.MaChuDe as int?;
    string? tuKhoa = ViewBag.TuKhoa as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Danh sách sự kiện &amp; hội thảo</h2>
    </div>

    <form method="get" asp-action="Index" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control" placeholder="Tìm theo tên sự kiện hoặc địa điểm..." />
        </div>
        <div class="col-md-4">
            <select name="maChuDe" class="form-select">
                <option value="">-- Tất cả chủ đề --</option>
                @foreach (var cd in chuDes)
                {
                    <option value="@cd.MaChuDe" selected="@(maChuDe == cd.MaChuDe)">
                        @cd.TenChuDe
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Chưa có sự kiện nào phù hợp.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(item.AnhBia))
                        {
                            <img src="@item.AnhBia" class="card-img-top" alt="@item.TieuDe" style="height: 180px; object-fit: cover;" />
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-secondary">@item.MaChuDeNavigation?.TenChuDe</span>
                                <span class="badge bg-light text-dark border">@item.TrangThai</span>
                            </div>
                            <h5 class="card-title">@item.TieuDe</h5>
                            <p class="card-text text-muted small mb-1">
                                <strong>Thời gian:</strong> @item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            <p class="card-text text-muted small mb-3">
                                <strong>Địa điểm:</strong> @(item.DiaDiem ?? "Đang cập nhật")
                            </p>
                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@item.MaSuKien" class="btn btn-sm btn-outline-primary w-100">
                                    Xem chi tiết &amp; phiên hội thảo
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>